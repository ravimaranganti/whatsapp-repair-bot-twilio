# Copy to .env — never commit .env

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
GEMINI_API_KEY=

# Set false while onboarding pros. Customers get a diagnosis and 3 Google listings, and no job is posted.
# CUSTOMER_REQUESTS_ENABLED=true

# Places API (New). Enable "Places API (New)" in Google Cloud Console for this project.
# Used only when a job matches zero partner pros. Results must be 4.6 stars with 30+ reviews.
# Leave empty to skip the lookup.
# GOOGLE_PLACES_API_KEY=

# Shown when a pro replies HELP. Named pairs override PRO_SUPPORT_PHONE.
# PRO_SUPPORT_CONTACTS=Ravi:+17134088948,Jay:+13466819558
# PRO_SUPPORT_PHONE=

# Pro dashboard. APP_BASE_URL falls back to PUBLIC_BASE_URL.
# Magic links stay off until DASHBOARD_SESSION_SECRET is set.
# APP_BASE_URL=
# PUBLIC_BASE_URL=
# DASHBOARD_SESSION_SECRET=

# Conversation memory: memory (local/simple Cloud Run) or firestore
# CONVERSATION_BACKEND=memory
# CONVERSATION_MAX_MESSAGES=24
# GOOGLE_CLOUD_PROJECT=agentic-corporate

# Vertex AI Memory Bank (optional — set after creating Reasoning Engine)
# VERTEX_AGENT_ENGINE_NAME=projects/.../locations/us-central1/reasoningEngines/...
# GOOGLE_CLOUD_REGION=us-central1

# WhatsApp Utility Content Template SIDs (HX...). Leave empty until approved.
# Set the same names on Cloud Run. Do not commit real SIDs.
TPL_JOB_ALERT_SID=
# Approved Utility dispatch ticket. Leave empty until WhatsApp approves it.
# TWILIO_DISPATCH_UTILITY_TEMPLATE_SID=

# WhatsApp number that gets a rescue ping when a job has no pro reply after 30 minutes.
# FOUNDER_ALERT_PHONE=
TPL_JOB_NOT_SELECTED_SID=
TPL_JOB_FOLLOWUP_SID=
TPL_JOB_REOPEN_SID=

# Homeowner buttons. Each id includes the job, and quote buttons include the pro too.
TPL_QUOTE_CHOICE_SID=
TPL_QUOTE_CARD_SID=
TPL_PRO_QUESTION_SID=
TPL_DISPATCH_CONSENT_SID=
TPL_SHARE_NOTES_SID=
TPL_NEW_ISSUE_SID=

# In-session role question (quick reply). No WhatsApp approval.
TPL_WELCOME_ROLE_SID=

# In-session pro trade list and add-another prompt. No WhatsApp approval.
TPL_PRO_TRADES_SID=

# WhatsApp Flow for multi-select trades and service areas. Needs Utility approval.
# PRO_PROFILE_FLOW_CONTENT_SID=
TPL_PRO_TRADE_MORE_SID=

# In-session Houston area list and add-another prompt. No WhatsApp approval.
TPL_PRO_AREAS_SID=
TPL_PRO_AREA_MORE_SID=

# In-session urgent-call and lead-time buttons. No WhatsApp approval.
TPL_PRO_EMERGENCY_SID=
TPL_PRO_LEAD_TIME_SID=

# In-session service-call fee buttons. No WhatsApp approval.
TPL_PRO_FEE_SID=

# In-session mobile auto repair button, language buttons, and insured buttons.
TPL_PRO_TRADES_EXTRA_SID=
TPL_PRO_LANGUAGE_SID=
TPL_PRO_INSURED_SID=
TPL_PRO_PHOTO_ESTIMATE_SID=

# Cloud Scheduler calls POST /api/cron/followups with this secret.
# CRON_SECRET=
TPL_KEEP_LOOKING_SID=
TPL_NO_REPLY_FOLLOWUP_SID=
TPL_QUOTE_REMINDER_SID=

# 48-hour check-in after phone numbers are exchanged. Utility template; needs WhatsApp approval.
# POST_JOB_CHECKIN_CONTENT_SID=
TPL_JOB_RESCUE_SID=

# Ops dashboard at /admin. Leave empty to keep the page closed.
# ADMIN_PASSWORD=
